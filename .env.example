# ============================================================================
#  copy this file to .env and adjust.  (.env is git-ignored - never commit it)
#  所有值都可以不填：默认配置即可离线跑通（LLM_PROVIDER=mock）。
#
#  ⚠️ 安全提醒：docker compose 会自动读取仓库根的 .env 做变量替换，
#     所以 `docker compose config` / `docker inspect` 会把 DEEPSEEK_API_KEY
#     的真实值打印出来。贴日志、截图、CI 输出前务必确认命令不会回显它，
#     或者用不含 Key 的 .env（LLM_PROVIDER=mock 时根本不需要 Key）。
# ============================================================================

# --- LLM -------------------------------------------------------------------
# mock     : 确定性假模型，不联网、不要 Key —— CI 和离线演示用
# deepseek : 接 DeepSeek API（需要下面的 Key）
# ollama   : 接本地 Ollama
# openai   : 接 OpenAI 兼容端点
LLM_PROVIDER=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 评测时设 0 保证可复现
LLM_TEMPERATURE=0.1

# --- 元数据库 ---------------------------------------------------------------
# 留空 = <repo>/data/agent.db（容器里是 /app/data/agent.db）
# 也可以写 sqlite:///相对路径 或 postgresql+asyncpg://user:pass@host/db
DATABASE_URL=

# --- 服务 -------------------------------------------------------------------
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
# 生产请改成具体域名，逗号分隔
CORS_ORIGINS=*

# --- 认证 / 权限 ------------------------------------------------------------
# !! 生产必须改 !! 用 `python -c "import secrets;print(secrets.token_urlsafe(48))"` 生成
AUTH_SECRET_KEY=dev-only-change-me-in-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# 首次启动、用户表为空时创建的初始管理员
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin12345
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- 查询与 SQL 安全 --------------------------------------------------------
MAX_QUERY_ROWS=100000
MAX_RETURN_ROWS=10000
SQL_MAX_CHARS=8000
# 没有 LIMIT 的 SELECT 自动补这个上限
SQL_DEFAULT_LIMIT=1000
# 默认全只读：写操作一律拒绝（建议永远保持 false）
SQL_ALLOW_WRITE_FOR_ADMIN=false
SQL_STATEMENT_TIMEOUT_SECONDS=15
SQL_MAX_RESULT_CELLS=200000
MAX_SQL_RETRIES=1

# --- 取数 -------------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=10
QUERY_RETRIES=1
PARALLEL_DATASOURCES=true

# --- 数据接入 ---------------------------------------------------------------
MAX_UPLOAD_MB=20
# 空库时自动生成 + 注册样例数据源（演示用）
SAMPLE_SEED_ENABLED=true

# --- 定时调度（跑在 task-worker 进程里）-------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=5

# --- 后台任务 ---------------------------------------------------------------
TASK_WORKERS=2
TASK_MAX_RETRIES=1
TASK_TIMEOUT_SECONDS=60
TASK_SERVICE_URL=http://127.0.0.1:8001
TASK_SERVICE_TIMEOUT_SECONDS=3
TASK_SERVICE_RETRIES=1

# --- 上下文压缩 -------------------------------------------------------------
CONTEXT_MAX_TOKENS=4000
CONTEXT_KEEP_RECENT=8

# --- 可观测 ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
LOG_RETENTION_DAYS=90
METRICS_ENABLED=true
TRACE_ENABLED=true
TRACE_DB_PATH=../data/traces.db

# --- 邮件（报告外发，可选）--------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 模型调用超时 -----------------------------------------------------------
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
